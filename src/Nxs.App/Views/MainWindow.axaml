<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nxs.App.ViewModels"
        x:Class="Nxs.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nexys XGT Simulator"
        Icon="/Assets/app.ico"
        Width="1180" Height="820"
        MinWidth="900" MinHeight="600">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">

    <!-- 헤더: 제목 + 서버 제어 -->
    <Border Grid.Row="0" Classes="card" Padding="20,16" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Nexys XGT Simulator" FontSize="19" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding RackSummary}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Spacing="2" VerticalAlignment="Bottom">
            <TextBlock Classes="fieldLabel" Text="프로젝트" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="OpenProjectButton" Click="OnOpenProjectClick" ToolTip.Tip="프로젝트 열기 (.nxp)">
                <PathIcon Data="{StaticResource IconFolder}" />
              </Button>
              <Button Name="SaveProjectButton" Click="OnSaveProjectClick" ToolTip.Tip="프로젝트 저장 (.nxp)">
                <PathIcon Data="{StaticResource IconSave}" />
              </Button>
              <Button Name="SaveTrafficButton" Click="OnSaveTrafficClick" ToolTip.Tip="트래픽 로그 저장">
                <PathIcon Data="{StaticResource IconDownload}" />
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Classes="fieldLabel" Text="바인딩 IP" />
            <TextBox Classes="mono" Width="130" Text="{Binding BindAddressText}"
                     IsEnabled="{Binding !IsServerRunning}" />
          </StackPanel>
          <StackPanel Spacing="2">
            <TextBlock Classes="fieldLabel" Text="포트" />
            <TextBox Classes="mono" Width="70" Text="{Binding PortText}"
                     IsEnabled="{Binding !IsServerRunning}" />
          </StackPanel>

          <!-- 접속 표시등 — 마스터가 붙으면 초록불이 들어온다 -->
          <Border Classes="pill" VerticalAlignment="Bottom" Padding="12,6"
                  ToolTip.Tip="{Binding ServerStatusText}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Classes="statusLamp" />
                <Ellipse Classes="statusLamp listening" IsVisible="{Binding IsListeningWithoutClient}" />
                <Ellipse Classes="statusLamp connected" IsVisible="{Binding IsClientConnected}" />
              </Grid>
              <TextBlock Text="{Binding ConnectionText}" FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Button Classes="accent" Content="{Binding StartStopLabel}" Width="76"
                  Command="{Binding ToggleServerCommand}"
                  IsEnabled="{Binding CanStartServer}" VerticalAlignment="Bottom" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ⛔ spec 게이트 안내 / ⚠️ 미검증 초안 코덱 안내 -->
    <StackPanel Grid.Row="1">
      <Border Classes="notice" Margin="0,0,0,12"
              IsVisible="{Binding ShowServerUnavailableNotice}">
        <StackPanel Spacing="4">
          <TextBlock Text="FEnet 서버를 켤 수 없습니다" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="{Binding ServerUnavailableReason}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- 랙 패널 -->
    <TabControl Grid.Row="2">

      <!-- 디지털 I/O: 하나의 목록, 모든 점이 양방향 -->
      <TabItem Header="디지털 I/O">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="디지털 주소 추가" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="모든 점이 양방향이다 — 비트를 눌러 쓰면 마스터가 읽고, 마스터가 쓰면 표시가 따라온다. 입력·출력을 나누지 않는다.&#10;비트뿐 아니라 바이트·워드·더블워드 주소도 되고, 그 경우 폭만큼 비트 배열로 펼쳐진다: %MX801(1개) · %MB40(8개) · %MW320(16개) · %MD422(32개) · %ML50(64개)" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="주소" />
                  <TextBox Classes="mono" Width="170" Text="{Binding NewDigitalAddress}"
                           Watermark="%MW0" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="별칭 (선택)" />
                  <TextBox Width="260" Text="{Binding NewDigitalLabel}" Watermark="운전 지령 워드" />
                </StackPanel>
                <Button Classes="accent" Content="추가" Command="{Binding AddDigitalPointCommand}"
                        VerticalAlignment="Bottom" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="softCard" Padding="14" Margin="0,0,0,12"
                  IsVisible="{Binding !HasDigitalGroups}">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="아직 디지털 점이 없습니다. 마스터가 읽거나 쓰는 주소를 넣으면 비트를 눌러 조작하고 값 변화도 볼 수 있습니다. 목록은 .nxp 에 함께 저장됩니다." />
          </Border>

          <ScrollViewer Grid.Row="2" IsVisible="{Binding HasDigitalGroups}">
            <ItemsControl ItemsSource="{Binding DigitalGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DigitalPointGroupViewModel">
                  <Border Classes="card" Padding="18" Margin="0,0,0,12">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mono" Text="{Binding AddressText}"
                                       FontWeight="SemiBold" FontSize="15" />
                            <Border Classes="pill" Padding="7,3" VerticalAlignment="Center">
                              <TextBlock Classes="mono" Text="{Binding SizeText}" FontSize="10" />
                            </Border>
                            <TextBlock Classes="mono" Text="{Binding ValueText}"
                                       VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    Margin="0,0,10,0" VerticalAlignment="Center"
                                    IsVisible="{Binding IsArray}">
                          <Button Content="전체 ON" Command="{Binding SetAllCommand}" FontSize="12" />
                          <Button Content="전체 OFF" Command="{Binding ClearAllCommand}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2" ToolTip.Tip="이 항목 제거"
                                Command="{Binding RemoveCommand}" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource IconRemove}" />
                        </Button>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding Bits}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:DigitalPointViewModel">
                            <ToggleButton Classes="ledToggle" Margin="0,0,6,6"
                                          IsChecked="{Binding IsOn}"
                                          ToolTip.Tip="{Binding AddressText}">
                              <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <Ellipse Classes="led" Classes.on="{Binding IsOn}" />
                                <TextBlock Classes="mono" Text="{Binding PointLabel}"
                                           HorizontalAlignment="Center" FontSize="11" />
                              </StackPanel>
                            </ToggleButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- A/D 입력: 사용자 지정 주소 + 공학단위 ↔ raw 변환 -->
      <TabItem Header="A/D 입력">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="A/D 채널 주소 추가" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="센서가 내는 아날로그 값을 흉내낸다. 공학단위(5 V)를 넣으면 스케일로 raw(2000)로 바꿔 메모리에 쓰고, 마스터가 그 워드를 실제 센서처럼 읽는다. 비트 주소는 쓸 수 없다." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="주소" />
                  <TextBox Classes="mono" Width="150" Text="{Binding NewAnalogAddress}"
                           Watermark="%IW80" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="별칭 (선택)" />
                  <TextBox Width="200" Text="{Binding NewAnalogLabel}" Watermark="탱크 압력" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="raw 최소" />
                  <TextBox Classes="mono" Width="86" Text="{Binding NewAnalogRawMin}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="raw 최대" />
                  <TextBox Classes="mono" Width="86" Text="{Binding NewAnalogRawMax}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="단위 최소" />
                  <TextBox Classes="mono" Width="86" Text="{Binding NewAnalogEuMin}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="단위 최대" />
                  <TextBox Classes="mono" Width="86" Text="{Binding NewAnalogEuMax}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="단위" />
                  <TextBox Width="64" Text="{Binding NewAnalogUnit}" Watermark="V" />
                </StackPanel>
                <Button Classes="accent" Content="추가" Command="{Binding AddAnalogPointCommand}"
                        VerticalAlignment="Bottom" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="softCard" Padding="14" Margin="0,0,0,12"
                  IsVisible="{Binding !HasAnalogPoints}">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="아직 A/D 채널이 없습니다. 마스터가 읽는 워드 주소와 스케일을 넣으면 공학단위로 값을 조작할 수 있습니다. 목록은 .nxp 에 함께 저장됩니다." />
          </Border>

          <ScrollViewer Grid.Row="2" IsVisible="{Binding HasAnalogPoints}">
            <ItemsControl ItemsSource="{Binding AnalogPoints}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AnalogPointViewModel">
                  <Border Classes="card" Padding="16" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="126,72,*,150,54,150,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" Text="{Binding AddressText}"
                                 FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                      <Border Grid.Row="0" Grid.Column="1" Classes="pill" Padding="7,3" Margin="0,0,10,0"
                              VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Classes="mono" Text="{Binding SizeText}" FontSize="10" />
                      </Border>
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Label}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                      <StackPanel Grid.Row="0" Grid.Column="3" Spacing="2" Margin="0,0,8,0">
                        <TextBlock Classes="fieldLabel" Text="공학단위" Margin="4,0,0,2" />
                        <TextBox Classes="mono" Text="{Binding EngineeringText}" />
                      </StackPanel>
                      <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding UnitText}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Bottom" Margin="0,0,8,7" FontSize="12" />
                      <StackPanel Grid.Row="0" Grid.Column="5" Spacing="2" Margin="0,0,10,0">
                        <TextBlock Classes="fieldLabel" Text="raw" Margin="4,0,0,2" />
                        <TextBox Classes="mono" Text="{Binding RawText}" />
                      </StackPanel>
                      <Button Grid.Row="0" Grid.Column="6" ToolTip.Tip="이 채널 제거"
                              Command="{Binding RemoveCommand}" VerticalAlignment="Bottom">
                        <PathIcon Data="{StaticResource IconRemove}" />
                      </Button>

                      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7"
                                  Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ScaleText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- 워치: 사용자 지정 임의 주소 (%MW320, %MD422 …) -->
      <TabItem Header="주소 워치">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="주소 추가" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="LabVIEW 가 실제로 교신하는 주소를 직접 지정한다. 랙 매핑과 무관한 %M 영역도 된다. 예: %MW320 · %MD422 · %ML50 · %MX801 · %MB40 · %IW80 · %QX1024&#10;표시 형식에 Float(4바이트 %..D) · Double(8바이트 %..L) 이 있고, 바이트 순서(워드오더)를 골라 마스터와 값 기준을 맞출 수 있다." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="주소" />
                  <TextBox Classes="mono" Width="150" Text="{Binding NewWatchAddress}"
                           Watermark="%MW320 · %MD422 · %ML50" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="fieldLabel" Text="별칭 (선택)" />
                  <TextBox Width="220" Text="{Binding NewWatchLabel}" Watermark="설정 압력" />
                </StackPanel>
                <Button Classes="accent" Content="추가" Command="{Binding AddWatchCommand}"
                        VerticalAlignment="Bottom" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="softCard" Padding="14" Margin="0,0,0,12"
                  IsVisible="{Binding !HasWatches}">
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="아직 워치가 없습니다. 위에 주소를 넣어 추가하면 값을 실시간으로 보고 직접 쓸 수 있습니다. [프로젝트 저장] 하면 목록이 .nxp 에 함께 저장됩니다." />
          </Border>

          <ScrollViewer Grid.Row="2" IsVisible="{Binding HasWatches}">
            <ItemsControl ItemsSource="{Binding Watches}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:WatchRowViewModel">
                  <Border Classes="card" Padding="14" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="118,66,*,180,162,180,Auto" >
                      <TextBlock Grid.Column="0" Classes="mono" Text="{Binding AddressText}"
                                 FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="pill" Padding="7,3" Margin="0,0,10,0"
                              VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Classes="mono" Text="{Binding SizeText}" FontSize="10" />
                      </Border>
                      <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Label}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="3" Spacing="2" Margin="0,0,10,0">
                        <TextBox Classes="mono" Text="{Binding ValueText}" />
                        <TextBlock Classes="error" Text="{Binding Error}" FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <ComboBox Grid.Column="4" ItemsSource="{Binding FormatOptions}"
                                SelectedItem="{Binding SelectedFormatOption}" Margin="0,0,8,0"
                                VerticalAlignment="Top" ToolTip.Tip="표시 형식" />
                      <ComboBox Grid.Column="5" ItemsSource="{Binding OrderOptions}"
                                SelectedItem="{Binding SelectedOrderOption}" Margin="0,0,10,0"
                                VerticalAlignment="Top" ToolTip.Tip="바이트 순서 (워드오더) — 마스터와 값 기준을 맞춘다"
                                IsVisible="{Binding SupportsByteOrder}" />
                      <Button Grid.Column="6" VerticalAlignment="Top"
                              ToolTip.Tip="이 워치 제거"
                              Command="{Binding RemoveCommand}">
                        <PathIcon Data="{StaticResource IconRemove}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- 트래픽 로그 -->
      <TabItem Header="트래픽 로그">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="방향" VerticalAlignment="Center" Classes="muted" />
              <ComboBox Name="TrafficDirectionBox" Width="196"
                        ItemsSource="{Binding DirectionOptions}"
                        SelectedItem="{Binding SelectedDirectionOption}"
                        DisplayMemberBinding="{Binding Label}"
                        ToolTip.Tip="RX = 마스터 → 시뮬 요청, TX = 시뮬 → 마스터 응답" />
              <CheckBox Content="오류만" IsChecked="{Binding ShowErrorsOnly}" VerticalAlignment="Center" />
              <CheckBox Content="일시정지" IsChecked="{Binding IsTrafficPaused}" VerticalAlignment="Center" />
              <Button Content="비우기" Command="{Binding ClearTrafficCommand}" />
              <Border Classes="pill" VerticalAlignment="Center">
                <TextBlock Text="{Binding TrafficSummary}" FontSize="12" />
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="주소 필터" VerticalAlignment="Center" Classes="muted" />
              <TextBox Name="NewTrafficAddressBox" Width="140" Classes="mono"
                       Text="{Binding NewTrafficAddress}" Watermark="%MW320"
                       ToolTip.Tip="비워 두면 전체 주소를 봅니다" />
              <Button Name="AddTrafficAddressButton" Content="주소 추가"
                      Command="{Binding AddTrafficAddressCommand}" />
              <Button Content="필터 지우기" Command="{Binding ClearTrafficAddressesCommand}"
                      IsEnabled="{Binding HasTrafficAddressFilter}" />
              <ItemsControl ItemsSource="{Binding TrafficAddresses}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="pill" Margin="0,0,6,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                                   FontSize="12" VerticalAlignment="Center" />
                        <Button Content="✕" FontSize="10" Padding="4,0" MinWidth="0"
                                Command="{Binding $parent[ItemsControl].DataContext.RemoveTrafficAddressCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="이 주소 필터 제거" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <Border Grid.Row="1" Classes="card" Padding="8">
            <DataGrid ItemsSource="{Binding TrafficRows}" IsReadOnly="True"
                      CanUserResizeColumns="True" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="시각" Binding="{Binding TimeText}" Width="134"
                                    FontFamily="Menlo,Consolas,monospace" />
                <DataGridTextColumn Header="방향" Binding="{Binding DirectionText}" Width="74"
                                    FontFamily="Menlo,Consolas,monospace" />
                <DataGridTextColumn Header="연결" Binding="{Binding ClientText}" Width="146"
                                    FontFamily="Menlo,Consolas,monospace" />
                <DataGridTextColumn Header="사유" Binding="{Binding ReasonText}" Width="152" />
                <DataGridTextColumn Header="주소" Binding="{Binding AddressText}" Width="150"
                                    FontFamily="Consolas,Menlo,monospace" />
                <DataGridTextColumn Header="해석" Binding="{Binding SummaryText}" Width="2*" />
                <DataGridTextColumn Header="raw hex" Binding="{Binding HexText}" Width="3*"
                                    FontFamily="Menlo,Consolas,monospace" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

    </TabControl>

    <!-- 하단 상태 라인 + 로고/저작권 (원본 nexys-modbus-workbench 푸터 이식) -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,10,4,2">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
        <TextBlock Classes="muted" Text="{Binding ServerStatusText}" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding TrafficSummary}" VerticalAlignment="Center" />
        <TextBlock Classes="muted" Text="{Binding ProjectPath}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="260" />
        <TextBlock Classes="muted" Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="© 2026 NEXYS · MIT licensed" Classes="muted" FontSize="11"
                   VerticalAlignment="Center" />
        <Image Source="/Assets/nexys-logo.png" Height="14" VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
